# ALPIXN website — environment variables (copy to .env.local and fill in).
# Never commit real values.

# MongoDB connection string (required). Pages fall back to built-in default
# content if the database is unreachable.
MONGODB_URI=mongodb://127.0.0.1:27017/alpixn

# Admin dashboard credentials and session signing secret (required for /admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Public site URL used for canonical/Open Graph metadata (optional, NEW in redesign).
# Defaults to https://alpixn.com when unset.
NEXT_PUBLIC_SITE_URL=https://alpixn.com

# --- Only for `npm run db:migrate` (scripts/migrate-mongodb.cjs) ---
# SOURCE_MONGODB_URI=
# TARGET_MONGODB_URI=
# SOURCE_DB_NAME=
# TARGET_DB_NAME=
# MIGRATION_BATCH_SIZE=500
# DROP_TARGET=false

# --- Form emails (Hostinger SMTP) ---
# Contact and Offshore Developer forms -> CONTACT_TO_EMAIL; career applications -> HR_TO_EMAIL.
# Hostinger: Emails -> your mailbox -> Configuration / "Connect apps & devices" shows these values.
CONTACT_TO_EMAIL=info@alpixn.com
HR_TO_EMAIL=hr@alpixn.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# Full mailbox address and its password (set real values only in Vercel / .env.local).
SMTP_USER=info@alpixn.com
SMTP_PASS=
# Sender address; with Hostinger it should be the same mailbox as SMTP_USER.
MAIL_FROM=info@alpixn.com

# --- AI Studio (Admin → AI Studio) ---
# Keys can also be saved (encrypted) from the admin; environment variables are used when no key is saved there.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional separate secret for encrypting keys saved in the admin (defaults to AUTH_SECRET).
AI_ENCRYPTION_KEY=
# Required for the weekly blog autopilot: Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Sales CRM (Admin → Sales CRM) ---
# Recommended: a separate sending domain/mailbox for outreach. Falls back to SMTP_* when not set.
SALES_SMTP_HOST=
SALES_SMTP_PORT=465
SALES_SMTP_USER=
SALES_SMTP_PASS=

# --- Spam protection (optional, free): Cloudflare Turnstile ---
# Create a widget at dash.cloudflare.com → Turnstile. The site key must be set before `npm run build`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
