# ALPIXN website — environment variables (copy to .env.local and fill in).
# Never commit real values.

# MongoDB connection string (required). Pages fall back to built-in default
# content if the database is unreachable.
MONGODB_URI=mongodb://127.0.0.1:27017/alpixn

# Admin dashboard credentials and session signing secret (required for /admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Public site URL used for canonical/Open Graph metadata (optional, NEW in redesign).
# Defaults to https://alpixn.com when unset.
NEXT_PUBLIC_SITE_URL=https://alpixn.com

# --- Only for `npm run db:migrate` (scripts/migrate-mongodb.cjs) ---
# SOURCE_MONGODB_URI=
# TARGET_MONGODB_URI=
# SOURCE_DB_NAME=
# TARGET_DB_NAME=
# MIGRATION_BATCH_SIZE=500
# DROP_TARGET=false
